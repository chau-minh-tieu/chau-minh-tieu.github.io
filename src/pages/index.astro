---
// Home: hero, the Writing list and the first projects of src/lib/projects.ts.
import PostList from '../components/PostList.astro';
import TopicChips from '../components/TopicChips.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listedPosts } from '../lib/collection.ts';
import { PROJECTS, SELECTED } from '../lib/projects.ts';

const posts = await listedPosts();
const selected = PROJECTS.slice(0, SELECTED);
---

<BaseLayout>
  <div class="wrap">
    <header class="hero">
      <p class="label eyebrow">
        <span class="engineering">Engineering</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="ai">AI</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="leadership">Leadership</span>
      </p>
      <h1>Notes on software, data &amp; AI, and engineering leadership.</h1>
      <p class="lede">
        I’m Chau Tieu, an engineering manager. I’ve been building software since 2010, and this is
        where I write down what I learn.
      </p>
    </header>

    <section class="writing" aria-labelledby="writing-title">
      <div class="writing-head">
        <h2 id="writing-title">Writing</h2>
        <TopicChips current="all" />
      </div>
      <PostList posts={posts} />
    </section>

    <section class="projects" aria-labelledby="projects-title">
      <div class="projects-head">
        <h2 id="projects-title">Selected projects</h2>
        <a class="all" href="/projects/">All projects<span aria-hidden="true"> →</span></a>
      </div>
      <div class="project-grid">
        {
          selected.map((project) => (
            <article class="project">
              <h3 class:list={['project-name', { mono: project.mono }]}>{project.name}</h3>
              <p class="project-description">{project.description}</p>
              {project.stack.length > 0 && <p class="label project-stack">{project.stack.join(' · ')}</p>}
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 880px;
    padding: 96px 0 88px;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .engineering {
    color: var(--engineering);
  }

  .ai {
    color: var(--ai);
  }

  .leadership {
    color: var(--leadership);
  }

  .dot {
    color: var(--muted);
  }

  h1 {
    font-size: var(--text-hero);
    line-height: var(--leading-hero);
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 640px;
    font-size: var(--text-lede);
    line-height: var(--leading-lede);
    color: var(--muted);
  }

  .writing {
    padding-bottom: 96px;
  }

  .writing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 32px;
  }

  h2 {
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: -0.02em;
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 112px;
  }

  /* The one full-strength rule on the page: it closes the Writing list. */
  .projects-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .all {
    font-size: var(--text-nav);
    font-weight: 600;
    text-decoration: none;
  }

  .all:hover {
    text-decoration: underline;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-name {
    font-size: 1.125rem;
    line-height: 1.625rem;
    letter-spacing: -0.01em;
  }

  .project-name.mono {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0;
  }

  .project-description {
    font-size: 1.0625rem;
    line-height: 1.75rem;
    color: var(--muted);
  }

  .project-stack {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
