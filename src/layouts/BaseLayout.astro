---
// The HTML document every page shares: <head>, theme bootstrap, fonts, nav,
// main content slot and footer. Rendered once per page at build time.
import { Font } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { OG_ALT, OG_HEIGHT, OG_WIDTH } from '../lib/brand.ts';
// Applies a stored theme before the first paint, so the page never flashes the
// other theme. Rendered with is:inline as a blocking <head> script (Astro would
// otherwise bundle it into a deferred module); astro.config.mjs adds its hash
// to the CSP.
import themeInit from '../scripts/theme-init.js?raw';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Asks search engines not to index the page (unlisted posts, 404). */
  noindex?: boolean;
  /** False for a page served at many addresses (404): no canonical URL, no og:url. */
  canonical?: boolean;
  /** Posts: Open Graph type `article` with these details. */
  article?: { published: Date; modified?: Date; tags: string[] };
}

const {
  title,
  description = 'Notes on software, data & AI, and engineering leadership.',
  noindex = false,
  canonical = true,
  article,
} = Astro.props;

const SITE_NAME = 'Chau Tieu';
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const url = new URL(Astro.url.pathname, Astro.site);
// Crawlers that draw link previews need absolute URLs (https://ogp.me/).
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInit} />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={url} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={url} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={OG_ALT} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
