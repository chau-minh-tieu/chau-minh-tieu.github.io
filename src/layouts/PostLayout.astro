---
// A post page: header with meta line, title, dek, byline and contents; the
// rendered Markdown in the reading column with sidenotes in the margin; and
// the footer with the disclosure, sources, discussion link and neighbours.
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/collection.ts';
import {
  TAG_LABELS,
  disclosureOf,
  discussUrl,
  formatDate,
  isoDate,
  postPath,
  primaryTag,
  readingTime,
} from '../lib/posts.ts';
import '../styles/prose.css';
import '../styles/code.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { data } = post;
const tag = primaryTag(post);
const sections = headings.filter((heading) => heading.depth === 2);
const disclosure = disclosureOf(data);
---

<BaseLayout title={data.title} description={data.description} noindex={data.status !== 'published'}>
  <div class="wrap">
    <article class="post" data-tag={tag}>
      <header class="post-head">
        <div class="post-intro">
          <p class="label post-meta">
            <a class="post-tag" href={`/tags/${tag}/`}>{TAG_LABELS[tag]}</a>
            <span aria-hidden="true">·</span>
            <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
            {
              data.updatedDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
                  </span>
                </>
              )
            }
            <span aria-hidden="true">·</span>
            <span>{readingTime(post.body ?? '')} min read</span>
          </p>
          <h1 class="post-title">{data.title}</h1>
          <p class="post-dek">{data.description}</p>
          <p class="byline">
            <img src="/brand/monogram-oxblood.svg" width="28" height="28" alt="" />
            <span class="byline-name">Chau Tieu</span>
            {data.aiAssisted && <span class="byline-note">· Drafted with AI, edited by me</span>}
          </p>
        </div>
        {
          sections.length > 0 && (
            <nav class="toc" aria-labelledby="toc-title">
              <p class="label toc-title" id="toc-title">
                On this page
              </p>
              <ol>
                {sections.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span class="toc-num">{i + 1}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="post-foot">
        {disclosure && <p class="disclosure">{disclosure}</p>}
        {
          data.sources.length > 0 && (
            <section class="sources" aria-labelledby="sources-title">
              <h2 class="label" id="sources-title">
                Sources
              </h2>
              <ol>
                {data.sources.map((source) => (
                  <li>
                    <a href={source.url}>{source.title}</a>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
        <a class="discuss" href={discussUrl(post)}>Discuss this post on GitHub →</a>
        {
          (newer || older) && (
            <nav class="pager" aria-label="More posts">
              {older && (
                <a class="pager-link" href={postPath(older)} rel="prev">
                  <span class="label">Previous</span>
                  <span class="pager-title">← {older.data.title}</span>
                </a>
              )}
              {newer && (
                <a class="pager-link pager-next" href={postPath(newer)} rel="next">
                  <span class="label">Next</span>
                  <span class="pager-title">{newer.data.title} →</span>
                </a>
              )}
            </nav>
          )
        }
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  import '../scripts/copy-code.ts';
</script>
