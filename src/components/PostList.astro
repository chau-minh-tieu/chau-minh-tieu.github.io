---
// Post rows, newest first: date, tag label with reading time, title,
// description. Shows an empty state when there is nothing to list.
import type { Post } from '../lib/collection.ts';
import { TAG_LABELS, formatDate, isoDate, postPath, primaryTag, readingTime } from '../lib/posts.ts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">No posts yet.</p>
  ) : (
    <div class="rows">
      {posts.map((post) => (
        <article class="row" data-tag={primaryTag(post)}>
          <time class="date" datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          <div class="body">
            <p class="label tag">
              {TAG_LABELS[primaryTag(post)]} · {readingTime(post.body ?? '')} min read
            </p>
            <h3 class="title">
              <a href={postPath(post)}>{post.data.title}</a>
            </h3>
            <p class="description">{post.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  )
}

<style>
  .rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 40px;
    row-gap: 8px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }

  .date {
    padding-top: 2px;
    font-size: 0.8125rem;
    line-height: var(--leading-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tag {
    color: var(--accent);
  }

  .title {
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    letter-spacing: -0.015em;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .description {
    max-width: var(--measure);
    font-size: 1.0625rem;
    line-height: 1.75rem;
    color: var(--muted);
  }

  .empty {
    padding: 28px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
