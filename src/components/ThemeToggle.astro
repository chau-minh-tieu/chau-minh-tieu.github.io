---
// Two-state theme button (44px target). aria-pressed="true" means dark.
// The inline script in BaseLayout.astro applies a stored choice before paint;
// this script only handles clicks and keeps aria-pressed in sync.
---

<button type="button" class="theme-toggle" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
  <svg
    class="icon-moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg
    class="icon-sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  type Theme = 'light' | 'dark';

  const root = document.documentElement;
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function currentTheme(): Theme {
    const stored = root.dataset.theme;
    if (stored === 'light' || stored === 'dark') return stored;
    return prefersDark.matches ? 'dark' : 'light';
  }

  function syncButtons(): void {
    const pressed = String(currentTheme() === 'dark');
    buttons.forEach((button) => button.setAttribute('aria-pressed', pressed));
  }

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const theme: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      try {
        localStorage.setItem('theme', theme);
      } catch {
        // Storage blocked (private mode, disabled cookies): the choice lasts
        // for this page only.
      }
      syncButtons();
    }),
  );

  prefersDark.addEventListener('change', syncButtons);
  syncButtons();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  /* Light theme shows the moon (switch to dark); dark shows the sun. */
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>
